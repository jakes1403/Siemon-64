{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "shell",
			"label": "libdragon make",
			"command": "libdragon make",
			"group": {
				"kind": "build",
				"isDefault": true
			  },
			  "problemMatcher": {
				"owner": "libdragon",
				"fileLocation": ["relative", "${workspaceFolder}"],
				"pattern": {
				  "regexp": "^(.*):(\\d+):(\\d+):\\s(error|warning):\\s(.*)$",
				  "file": 1,
				  "line": 2,
				  "column": 3,
				  "severity": 4,
				  "message": 5
				}
			  }
		}
	]
}